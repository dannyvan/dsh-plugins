{
  "name": "dsh-version",
  "version": "1.0.0",
  "description": "左下角显示 DeepSeek Harness 版本号；npm 有新版本时高亮提示可跳转 Releases，已安装插件（dshmarket 管理）有新版本时提示「N 个插件可更新」并给出更新命令",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
