    "client.js",
    "mount.js",
    "translate.js",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
